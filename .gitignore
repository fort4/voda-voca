# 환경 변수 실파일 (비밀번호 포함) - 커밋 금지, .env.example 만 커밋
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Test coverage 산출물
.coverage
htmlcov/

# DB 백업 덤프 (개인 학습 데이터 포함) - 커밋 금지
ai-agent/backups/

# Windows 다운로드 표식 파일 (NTFS 대체 데이터 스트림) - 커밋 금지
*:Zone.Identifier
