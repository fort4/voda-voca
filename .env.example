# voda-voca 환경 변수 템플릿
# 사용법: 이 파일을 .env 로 복사한 뒤 실제 값으로 수정한다. (.env 는 커밋하지 않는다)

# --- Timezone ---
TZ=Asia/Seoul

# --- MySQL (Docker 컨테이너) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=voda_voca
MYSQL_USER=voda_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# --- Auth (세션 쿠키) ---
# 로컬 HTTP 개발은 false, HTTPS 배포 시 true
COOKIE_SECURE=false
