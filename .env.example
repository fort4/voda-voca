# voda-voca 환경 변수 템플릿
# 사용법: 이 파일을 .env 로 복사한 뒤 실제 값으로 수정한다. (.env 는 커밋하지 않는다)

# --- Timezone ---
TZ=Asia/Seoul

# --- DB (SQLite 파일 하나. 로컬 개발은 상대 경로도 가능) ---
# 컨테이너에서는 /data 볼륨 아래에 둔다 (과제 서버 규칙: 쓰기는 /data 와 /tmp 에만 허용)
DB_PATH=./data/voca.db

# --- 비밀값 (코드에 넣지 않는다) ---
SECRET_KEY=change_me

# --- Auth (세션 쿠키) ---
# 로컬 HTTP 개발은 false, HTTPS 배포 시 true
COOKIE_SECURE=false

# --- App (docker compose 의 app 서비스가 호스트에 여는 포트) ---
APP_PORT=8080
